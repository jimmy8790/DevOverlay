<UserControl x:Class="DevOverlay.UI.ColorPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
          BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
          BorderThickness="1" Padding="10">
    <StackPanel Width="200">
      <!-- Saturation (x) / value (y) area for the current hue. -->
      <Grid x:Name="SvArea" Height="130" Cursor="Cross" ClipToBounds="True" Background="Red"
            MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnSvMouseUp">
        <Rectangle IsHitTestVisible="False">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FFFFFFFF" Offset="0" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0" />
              <GradientStop Color="#FF000000" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Canvas IsHitTestVisible="False">
          <Ellipse x:Name="SvThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2" />
        </Canvas>
      </Grid>
      <Grid x:Name="HueBar" Height="14" Margin="0,8,0,8" Cursor="Hand" ClipToBounds="True" Background="Transparent"
            MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnHueMouseUp">
        <Canvas IsHitTestVisible="False">
          <Rectangle x:Name="HueThumb" Width="4" Height="14" Stroke="White" StrokeThickness="1.5" />
        </Canvas>
      </Grid>
      <WrapPanel x:Name="PresetPanel" />
    </StackPanel>
  </Border>
</UserControl>
